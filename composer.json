{
  "name": "conductor/ssh-support",
  "version": "3.0.0",
  "description": "Conductor SSH Support",
  "type": "library",
  "homepage": "https://github.com/conductorphp/conductor-ssh-support",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Kirk Madera",
      "email": "kirk.madera@rmgmedia.com",
      "role": "Architect"
    }
  ],
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": "~8.2.0|~8.3.0|~8.4.0|~8.5.0",
    "conductor/core": "^2.0",
    "phpseclib/phpseclib": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0.16",
    "laminas/laminas-coding-standard": "^2.5.0",
    "phpspec/prophecy-phpunit": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "ConductorSshSupport\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ConductorSshSupportTest\\": "test/"
    }
  },
  "extra": {
    "laminas": {
      "config-provider": "ConductorSshSupport\\ConfigProvider"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@test"
    ],
    "cs-check": "phpcs",
    "cs-fix": "phpcbf",
    "test": "phpunit --colors=always",
    "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
  }
}